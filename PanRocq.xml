<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE language SYSTEM "language.dtd">
<!--
  KDE XML syntax definition for Rocq.
  Converted from Rocq.sublime-syntax for use with Pandoc/Quarto.
  Original Rocq.sublime-syntax file available at
    https://github.com/mattam82/rocq-sublime
    (Copyright (c) Matthieu Sozeau 2025, MIT License)

  Rules are tried in order; the first match wins.
  defStyleNum values map to Pandoc JSON theme token types:
    dsKeyword      -> Keyword
    dsControlFlow  -> ControlFlow
    dsDataType     -> DataType
    dsConstant     -> Constant
    dsFunction     -> Function
    dsBuiltIn      -> BuiltIn
    dsDecVal       -> DecVal
    dsString       -> String
    dsSpecialChar  -> SpecialChar
    dsComment      -> Comment
-->
<language name="Rocq" version="1" section="Sources"
          alternativeNames="rocq;coq;Coq"
          extensions="*.v" mimetype="text/x-rocq" casesensitive="true"
          author="Converted from Rocq.sublime-syntax" license="MIT">
  <highlighting>

    <!-- ============================================================ -->
    <!-- Keyword lists                                                 -->
    <!-- ============================================================ -->

    <!-- Definition-introducing vernacular commands (directly followed by a name) -->
    <list name="kw_definition">
      <item>Theorem</item>
      <item>Lemma</item>
      <item>Remark</item>
      <item>Fact</item>
      <item>Corollary</item>
      <item>Proposition</item>
      <item>Example</item>
      <item>Let</item>
      <item>Definition</item>
      <item>CoFixpoint</item>
      <item>Fixpoint</item>
      <item>Equations</item>
    </list>

    <!-- Assumption-introducing vernacular commands -->
    <list name="kw_declaration">
      <item>Axiom</item>
      <item>Conjecture</item>
      <item>Parameter</item>
      <item>Parameters</item>
      <item>Variable</item>
      <item>Variables</item>
      <item>Hypothesis</item>
      <item>Hypotheses</item>
    </list>

    <!-- Inductive type commands -->
    <list name="kw_inductive">
      <item>Inductive</item>
      <item>CoInductive</item>
      <item>Variant</item>
      <item>Record</item>
      <item>Structure</item>
      <item>Class</item>
    </list>

    <!-- Other vernacular commands (note: Set omitted; it is highlighted as a sort) -->
    <list name="kw_vernacular">
      <item>Program</item>
      <item>Polymorphic</item>
      <item>Cumulative</item>
      <item>Fail</item>
      <item>Universe</item>
      <item>Proof</item>
      <item>Qed</item>
      <item>Defined</item>
      <item>Admitted</item>
      <item>Abort</item>
      <item>Save</item>
      <item>From</item>
      <item>Require</item>
      <item>Import</item>
      <item>Export</item>
      <item>Module</item>
      <item>End</item>
      <item>Section</item>
      <item>Notation</item>
      <item>Infix</item>
      <item>Context</item>
      <item>Unset</item>
      <item>Print</item>
      <item>About</item>
      <item>Check</item>
      <item>Compute</item>
      <item>Eval</item>
      <item>Goal</item>
      <item>Search</item>
      <item>MetaRocq</item>
      <item>Run</item>
      <item>Open</item>
      <item>Close</item>
      <item>Scope</item>
      <item>Arguments</item>
      <item>Instance</item>
      <item>Global</item>
      <item>Local</item>
      <item>Opaque</item>
      <item>Transparent</item>
      <item>Hint</item>
      <item>Declare</item>
    </list>

    <!-- Term-level keywords: binders, local definitions, structural keywords -->
    <list name="kw_term">
      <item>fun</item>
      <item>forall</item>
      <item>exists</item>
      <item>exists2</item>
      <item>let</item>
      <item>fix</item>
      <item>cofix</item>
      <item>with</item>
      <item>match</item>
      <item>as</item>
      <item>at</item>
      <item>else</item>
      <item>end</item>
      <item>for</item>
      <item>if</item>
      <item>in</item>
      <item>mod</item>
      <item>return</item>
      <item>then</item>
      <item>where</item>
      <item>of</item>
    </list>

    <!-- Universe sorts: highlighted as types -->
    <list name="sorts">
      <item>SProp</item>
      <item>Prop</item>
      <item>Set</item>
      <item>Type</item>
    </list>

    <!-- Proof tactics -->
    <list name="tactics">
      <item>admit</item>
      <item>all</item>
      <item>apply</item>
      <item>assert</item>
      <item>assumption</item>
      <item>auto</item>
      <item>autounfold</item>
      <item>case</item>
      <item>clear</item>
      <item>compute</item>
      <item>constructor</item>
      <item>contradiction</item>
      <item>dependent</item>
      <item>destruct</item>
      <item>discriminate</item>
      <item>do</item>
      <item>eapply</item>
      <item>eauto</item>
      <item>easy</item>
      <item>elim</item>
      <item>exact</item>
      <item>exfalso</item>
      <item>firstorder</item>
      <item>generalize</item>
      <item>give_up</item>
      <item>induction</item>
      <item>injection</item>
